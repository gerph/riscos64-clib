MEMORY
{
    /* We build our modules to start at offset 4 to allow for the module heap header */
    rmf (rwx) : ORIGIN = 0x4, LENGTH = 0x10000000
}

SECTIONS
{
    RMF_BASE = 0x4;

    .text RMF_BASE :
    {
        __CodeStart = ABSOLUTE(.);

        KEEP(*(.init.rmf));
        *(.init.rmf)
        *(.text)
        *(SORT(.text.*))
        . = ALIGN(16);
        __CodeEnd = ABSOLUTE(.);
    } > rmf
    __CodeSize = SIZEOF(.text);

    .rodata . : {
        __RODataStart = ABSOLUTE(.);

        /* Initialiser data */
        __InitsStart = ABSOLUTE(.);
        KEEP (*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        *(.init_array)
        *(.ctors)
        __InitsEnd = ABSOLUTE(.);
        /* Finaliser data */
        __FinalsStart = ABSOLUTE(.);
        KEEP (*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
        *(.fini_array)
        *(.dtors)
        __FinalsEnd = ABSOLUTE(.);

        *(.rodata)
        *(.data.ro)
        *(SORT(.rodata.*))
        *(SORT(.data.ro.*))

        . = ALIGN(8);
        __GOTStart = ABSOLUTE(.);
        *(.got)
        *(.got.plt)
        __GOTEnd = ABSOLUTE(.);

        . = ALIGN(8);
    } > rmf

    .data.rel.ro . : {
        __RODataRelStart = ABSOLUTE(.);
        *(.data.rel.ro)
        *(SORT(.data.rel.ro.*))

        *(.riscos.reloc)

        /* Align the following data (R/W) region at a page boundary - the
           first thing after this is .data.rel, not .data, since .data.rel
           is placed ahead of .data below (see __DataStart's own comment) */
        . = ALIGN(4096);
    } > rmf
    __RODataEnd = ABSOLUTE(.);
    __RODataRelEnd = ABSOLUTE(.);

    __RODataSize = SIZEOF(.rodata) + SIZEOF(.data.rel.ro);
    __ROSize = __RODataSize + __CodeSize;

    /* .data.rel is placed ahead of .data (rather than after, as it used
       to be) purely so the *(SORT(.data.*)) catch-all in .data's own
       block below can't accidentally claim a .data.rel/.data.rel.* input
       section before this block gets to. __DataStart must still mark
       .data's own true start, not this block's - riscos64-mkreloc
       (crosscompile/riscos64/bin/riscos64-mkreloc) computes a
       relocation's runtime address as __DataStart's own runtime value
       plus the section-relative offset objdump reports for a plain
       ".data+0xNN" relocation, so __DataStart has to coincide exactly
       with .data's real base address or every such relocation lands
       .data.rel-worth of bytes short. See __DataStart's own comment
       below. */
    __DataRelStart = ABSOLUTE(.);
    .data.rel . : {
        . = ALIGN(16);
        *(.data.rel)
        *(SORT(.data.rel.*))

        . = ALIGN(16);
    } > rmf
    __DataRelEnd = ABSOLUTE(.);
    __DataRelSize = SIZEOF(.data.rel);

    .data . : {
        __DataStart = ABSOLUTE(.);
        *(.data)
        /* Catch-all for any other per-symbol .data.<name> section a
           compiler emits (eg. Rust's per-item-section codegen, which
           doesn't follow GCC's convention of routing relocation-needing
           globals through a distinctly-named .data.rel[.local] section).
           .data.rel/.data.rel.* and .data.rel.ro/.data.rel.ro.* are
           already claimed by their own dedicated SECTIONS blocks above,
           so this only sweeps up what's left. Every other category here
           (.text.*, .rodata.*, .data.rel.ro.*, .data.rel.*, .bss.*)
           already has an equivalent wildcard; this one didn't, so an
           unmatched .data.<name> fell through to the trailing /DISCARD/
           below - fatally, if something else still held a relocation
           into it ("... referenced in section ...: defined in discarded
           section ..." from ld, seen linking a no_std + alloc Rust
           object against a std built with a newer core::io::error that
           added such a section). */
        *(SORT(.data.*))
        . = ALIGN(16);

        /* The zero initialised region follows */
    } > rmf
    __DataEnd = ABSOLUTE(.);
    __DataSize = SIZEOF(.data) + SIZEOF(.data.rel);

    __ZIStart = ABSOLUTE(.);
    .bss (NOLOAD) : {
        *(.bss .bss.*)
        . = ALIGN(16);
    } > rmf
    __ZIEnd = ABSOLUTE(.);
    __ZISize = SIZEOF(.bss);


    __RWSize = __DataSize + __ZISize;

    /* Discard any sections not named */
    /DISCARD/ : {*(*)}
}
